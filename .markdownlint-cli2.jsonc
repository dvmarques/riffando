{
  "globs": ["*.md", "docs/**/*.md", "openspec/**/*.md", ".github/**/*.md"],
  // Preservar o texto da licença, inclusive URLs originais sem formatação adicional.
  "ignores": ["node_modules/**", "LICENSE.md"],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD060": false
  }
}
